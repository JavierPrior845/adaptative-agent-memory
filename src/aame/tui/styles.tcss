/* AAME Cockpit Theme: Muted Dark Slate + Vibrant Semantic Accents */
/* Inspired by modern developer tools (Claude Code, OpenCode, Lazygit) */

Screen {
    background: #0d1117;
    color: #c9d1d9;
}

Header {
    background: #161b22;
    color: #58a6ff;
    dock: top;
    height: 1;
}

Footer {
    background: #161b22;
    color: #8b949e;
    dock: bottom;
}

#main-container {
    height: 1fr;
    layout: horizontal;
}

/* Sidebar for Sessions */
#sidebar {
    width: 28%;
    min-width: 28;
    background: #11151c;
    border-right: solid #21262d;
    padding: 1 1;
}

/* Main Workspace */
#workspace {
    width: 72%;
    layout: vertical;
    padding: 1 1;
}

/* Metrics Bar Area */
#metrics-panel {
    height: auto;
    max-height: 11;
    background: #161b22;
    border: round #30363d;
    padding: 1 2;
    margin-bottom: 1;
}

/* Split Pane for Messages & Detail */
#split-workspace {
    height: 1fr;
    layout: horizontal;
}

#messages-container {
    width: 55%;
    border: round #21262d;
    background: #0d1117;
    padding: 0 1;
}

#detail-container {
    width: 45%;
    border: round #21262d;
    background: #11151c;
    padding: 1 1;
}

.pane-title {
    color: #58a6ff;
    text-style: bold;
    margin-bottom: 1;
    border-bottom: solid #30363d;
}

.pane-title-dim {
    color: #8b949e;
    text-style: bold;
    margin-bottom: 1;
}

/* Session List Styling */
#session-list {
    height: 1fr;
    scrollbar-gutter: stable;
}

ListItem {
    padding: 1 1;
    color: #8b949e;
}

ListItem:hover {
    background: #1b212c;
    color: #f0f6fc;
}

ListItem.-selected {
    background: #1f6feb;
    color: #ffffff;
    text-style: bold;
}

/* Data Table Styling */
DataTable {
    background: #0d1117;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #161b22;
    color: #58a6ff;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #238636;
    color: #ffffff;
    text-style: bold;
}

/* Detail view markdown content */
#message-content {
    height: 1fr;
    overflow-y: scroll;
}

/* Status Badges */
.badge-clean {
    color: #3fb950;
    text-style: bold;
}

.badge-noise {
    color: #d29922;
    text-style: bold;
}

.badge-tool {
    color: #bc8cff;
}

.badge-arch {
    color: #58a6ff;
    text-style: bold;
}
